version: "3.7"

services:
  # De proxy die de app toegankelijk maakt. Poort 3000 wordt hier doorgestuurd naar poort 8095 op je ZimaOS.
  app_proxy:
    image: nginx:alpine # Umbrel gebruikt hier normaal een ingebouwde proxy voor; we mappen de app nu direct of via nginx indien de proxy-image ontbreekt.
    # Omdat het origineel geen image specificeerde (Umbrel regelt dit intern), koppelen we de app-poort direct via de 'app' service hieronder.
    
bch2:
    image: ghcr.io/willitmod/axebch2-node:0.1.33-dev
    restart: unless-stopped
    stop_grace_period: 15m30s
    depends_on:
      init_permissions:
        condition: service_completed_successfully
    environment:
      NETWORK: "mainnet"
      RPC_USER: "pooluser"
      RPC_PASSWORD: "poolpassword" # VERANDERING: Moet gelijk zijn aan BCH2_RPC_PASS hierboven
      RPC_PORT: "9031"
      P2P_PORT: "8339"
      ZMQ_PORT: "7031"
      EXTERNAL_IP: "127.0.0.1"               # Vul hier eventueel het echte LAN-IP van je ZimaOS in
      FORCE_IPV4_BIND: "1"
      PRUNE: "0"
      RPC_THREADS: "4"
      MAX_MEMPOOL: "64"
      DB_CACHE: "256"
      TX_INDEX: "0"
      BOOTSTRAP_CONNECTNODES: ""
      PEER_WATCHDOG_INTERVAL: "30"
      PEER_WATCHDOG_MIN_CONNECTIONS: "1"
      ONE_TIME_FULL_RESYNC_KEY: "bitcoincashii-shadow-chain-20260413"
      ONE_TIME_FULL_RESYNC_REQUIRE_EXISTING_DATA: "1"
      ONE_TIME_REINDEX_KEY: "bitcoincashii-v27.0.2"
      ONE_TIME_REINDEX_REQUIRE_EXISTING_DATA: "1"
    volumes:
      - /DATA/AppData/axebch2/data/node:/data/node
    ports:
      - "8339:8339/tcp"
      - "7031:7031"
      - "9031:9031"
    healthcheck:
      test:
        - CMD-SHELL
        - bitcoincashII-cli -datadir=/data/node -rpcuser="$$RPC_USER" -rpcpassword="$$RPC_PASSWORD" getblockchaininfo >/dev/null 2>&1
      interval: 30s
      timeout: 10s
      retries: 20
      start_period: 2m

# Integratie met het ZimaOS Dashboard
x-casaos:
  author: WillItMod
  category: Crypto
  icon: https://githubusercontent.com
  index: /
  port_map: "8095"
  scheme: http
  title:
    en_US: AxeBch2 Dev

